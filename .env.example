# Ollama Configuration (DEFAULT - FREE via Ollama!)
# Uses Ollama's minimax-2.1:cloud model
USE_OLLAMA=true
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=minimax-2.1:cloud

# Minimax Cloud API (OPTIONAL - only if you want direct API instead)
# Leave blank if using Ollama
MINIMAX_API_KEY=
MINIMAX_GROUP_ID=

# Application Settings
WORKSPACE_DIR=./workspace
LOG_LEVEL=INFO
LOG_FILE=./logs/assistant.log

# Safety Settings
ENABLE_SHELL_COMMANDS=true
MAX_FILE_SIZE_MB=100
TIMEOUT_SECONDS=300
MAX_TOOL_ITERATIONS=10
